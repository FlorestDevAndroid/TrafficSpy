<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:fitsSystemWindows="true"
              android:padding="16dp">

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Traffic Monitor"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

    <Button
            android:id="@+id/btn_start_vpn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start VPN"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

    <Button
            android:id="@+id/btn_stop_vpn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stop VPN"
            android:enabled="false"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Network Activity:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

    <ScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp">

        <TextView
                android:id="@+id/tv_network_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F5F5F5"
                android:padding="10dp"
                android:text="No traffic yet..."
                android:textSize="12sp"
                android:typeface="monospace" />
    </ScrollView>

    <Button
            android:id="@+id/btn_export_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export Logs"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF" />

</LinearLayout>